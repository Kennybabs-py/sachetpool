// Sachet pari-mutuel prediction market schema.
//
// Chain is the source of truth for money: the on-chain `SachetMarket` singleton
// escrows all `$SACH`. Postgres is a *mirror* rebuilt from contract events by
// the indexer (`lib/indexer.ts`) for reads (board, history, leaderboard) and for
// off-chain match/pool metadata (fixtures, expiry, rake).
//
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Match lifecycle, mirrored from the football provider.
enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

/// The only market type in v1: match result (HOME / DRAW / AWAY).
enum PoolType {
  RESULT_1X2
}

/// Pool lifecycle. `LOCKED` is derived at read time from `closesAt` (no cron);
/// `PENDING_ONCHAIN` means the DB row exists but `createPool` hasn't confirmed.
enum PoolStatus {
  PENDING_ONCHAIN
  OPEN
  LOCKED
  RESOLVED
  VOID
}

enum Selection {
  HOME
  DRAW
  AWAY
}

/// Mirrored bet lifecycle. `WON`/`VOID` mean claimable on-chain; `CLAIMED`
/// means the pull-payment has been withdrawn.
enum BetStatus {
  PENDING
  WON
  LOST
  VOID
  CLAIMED
}

/// Wallet identity. The lowercase address is the primary identity everywhere.
model User {
  id        String   @id @default(cuid())
  address   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bets      Bet[]
}

model Match {
  id           String      @id @default(cuid())
  externalId   String      @unique
  league       String
  season       Int
  homeTeam     String
  awayTeam     String
  homeTeamLogo String?
  awayTeamLogo String?
  kickoffAt    DateTime
  status       MatchStatus @default(SCHEDULED)
  homeScore    Int?
  awayScore    Int?
  settledAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  pools        Pool[]

  @@index([kickoffAt])
  @@index([status])
}

/// One pari-mutuel pool per match, backed by one on-chain pool.
model Pool {
  id               String      @id @default(cuid())
  matchId          String
  match            Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// keccak256("sachet:1x2:" + match.externalId) — stable and idempotent.
  onchainPoolId    String      @unique
  type             PoolType    @default(RESULT_1X2)
  status           PoolStatus  @default(PENDING_ONCHAIN)
  rakeBps          Int         @default(0)
  /// Selection expiry; betting is rejected on-chain from this instant.
  closesAt         DateTime
  createdBy        String?
  createTxHash     String?
  totalStake       BigInt      @default(0)
  stakeHome        BigInt      @default(0)
  stakeDraw        BigInt      @default(0)
  stakeAway        BigInt      @default(0)
  winningSelection Selection?
  resolvedTxHash   String?
  settledAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  bets             Bet[]

  @@unique([matchId, type])
  @@index([status])
}

model Bet {
  id          String    @id @default(cuid())
  poolId      String
  pool        Pool      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lowercase address that placed the bet (denormalised for history reads).
  address     String
  selection   Selection
  amount      BigInt
  status      BetStatus @default(PENDING)
  payout      BigInt    @default(0)
  txHash      String
  logIndex    Int
  blockNumber BigInt
  claimTxHash String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([txHash, logIndex])
  @@index([poolId])
  @@index([status])
  @@index([userId])
  @@index([address])
}

/// Raw decoded contract event, for audit and safe replay.
model ChainEvent {
  id          String   @id @default(cuid())
  txHash      String
  logIndex    Int
  blockNumber BigInt
  address     String
  eventName   String
  poolId      String?
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([eventName])
  @@index([blockNumber])
}

/// Indexer high-water mark. `id = "<chainId>:<market>"`.
model ChainCursor {
  id        String   @id
  lastBlock BigInt   @default(0)
  updatedAt DateTime @updatedAt
}
